{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/build": {
      "entry": ["src/**/*.js", "src/**/*.ts"],
      "project": ["src/**/*.js", "src/**/*.ts"],
      "ignoreDependencies": ["esbuild", "playwright"]
    },
    "packages/e2e": {
      "entry": ["src/**/*.ts", "fixtures/**/*.js"],
      "project": ["src/**/*.ts", "fixtures/**/*.js"],
      "ignoreDependencies": ["playwright-core"]
    },
    "packages/server": {
      "entry": ["src/**/*.js"],
      "project": ["src/**/*.js"]
    },
    "packages/source-action-worker": {
      "entry": ["src/sourceActionWorkerMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  },
  "ignoreIssues": {
    "packages/source-action-worker/src/parts/DomEventListenerFunctions/DomEventListenerFunctions.ts": ["exports"],
    "packages/source-action-worker/src/parts/EditorWorker/EditorWorker.ts": ["exports"],
    "packages/source-action-worker/src/parts/UiStrings/UiStrings.ts": ["exports"],
    "packages/source-action-worker/src/parts/VirtualDomElements/VirtualDomElements.ts": ["exports"],
    "packages/source-action-worker/src/parts/WhenExpression/WhenExpression.ts": ["exports"],
    "packages/source-action-worker/src/parts/WidgetId/WidgetId.ts": ["exports"]
  }
}
